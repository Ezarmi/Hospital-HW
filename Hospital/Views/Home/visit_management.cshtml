
@{
    Layout = "~/Views/shared/layout.cshtml";
}

<div class="panel panel-primary filterable">
    <div class="panel-heading">
        <h3 class="panel-title">Users</h3>
        <div class="pull-left">
            <button class="btn btn-default btn-xs btn-filter"><span class="fa fa-filter"></span> فیلتر</button>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr class="filters">
                <th><input type="text" class="form-control" placeholder="نوبت" disabled></th>
                <th><input type="text" class="form-control" placeholder="دکتر" disabled></th>
                <th><input type="text" class="form-control" placeholder="تاریخ" disabled></th>
                <th><input type="text" class="form-control" placeholder="ساعت" disabled></th>
                <th><input type="text" class="form-control" placeholder="بیمار" disabled></th>
                <th><input type="text" class="form-control" placeholder="تماس بیمار" disabled></th>
            </tr>
        </thead>
        <tbody id="tbl_visits">
            
        </tbody>
    </table>
</div>

@section script{
    
    <script src="~/assets/js/visit.js"></script>
}
